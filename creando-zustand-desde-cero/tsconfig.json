{
  "compilerOptions": {
    "target": "ESNext",
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "bun-env.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}